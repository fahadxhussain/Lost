{
  "name": "comsats-lost-and-found-backend",
  "version": "1.0.0",
  "description": "Backend API and Matching Worker for COMSATS Lost & Found",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "worker": "node --watch src/workers/matchingWorker.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed:demo": "node prisma/seedDemo.js",
    "test": "jest --runInBand",
    "test:account": "jest tests/account.unit.test.js --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  }
}
