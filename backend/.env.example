# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8081

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comsats_lost_found?schema=public"

# Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d

# University Email Policy
# Allowed domains (comma-separated, case-insensitive)
ALLOWED_EMAIL_DOMAINS="isbstudent.comsats.edu.pk,comsats.edu.pk"
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5

# Gemini AI Provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Email Service (for OTP delivery)
# Set to 'console' for local dev (prints OTP in terminal) or 'smtp' for real mail
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="COMSATS Lost & Found <no-reply@comsats.edu.pk>"

# Upload / Storage Provider
# 'local' or 'cloudinary'
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
