{
  "expo": {
    "name": "COMSATS Lost & Found",
    "slug": "comsats-lost-and-found",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B3048"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B3048"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of your lost or found item.",
          "cameraPermission": "Take a photo of your lost or found item."
        }
      ]
    ]
  }
}
